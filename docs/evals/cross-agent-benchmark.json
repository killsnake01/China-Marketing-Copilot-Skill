{
  "version": 2,
  "updated": "2026-07-30",
  "status": "benchmark_ready_no_live_results",
  "purpose": "用同一组盲测任务比较不同智能体的触发、路由、证据纪律和交付质量。",
  "target_agents": ["codex", "openclaw", "hermes", "gpt"],
  "agent_package_profiles": {
    "codex": "codex",
    "openclaw": "clawhub",
    "hermes": "hermes-personal",
    "gpt": "codex"
  },
  "integrity_rules": [
    "运行目标智能体时只提供用户任务和待测技能包，不提供本评测文件。",
    "保留原始输出，不先提示预期路由、错误类型或参考答案。",
    "真实运行结果单独保存，不写回发布包。",
    "静态校验通过只代表评测框架可用，不代表任何智能体已经通过。"
  ],
  "run_contract": {
    "required_fields": ["case_id", "agent", "triggered", "selected_route", "selected_mode", "output"],
    "release_required_fields": ["captured_at", "skill_version", "runtime_package_fingerprint_sha256"],
    "selected_route_format": "命中技能时填写 docs/routes/*.md；未命中时填写 null。",
    "selected_mode_values": ["快速版", "标准版", "深度版", "不适用"]
  },
  "pass_policy": {
    "minimum_case_pass_rate": 0.85,
    "hard_fail_checks": ["trigger", "route", "forbidden_regex", "advanced_section_leakage", "frontstage_language_leakage"],
    "release_claim_rule": "每个目标智能体完成全部案例后，才允许声明该智能体兼容。"
  },
