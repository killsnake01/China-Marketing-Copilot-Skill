{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/china-marketing-copilot/evidence-ledger.schema.json",
  "title": "中国3C营销助手证据来源台账",
  "type": "object",
  "required": ["version", "updated", "status_definitions", "policy", "sources"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "status_definitions": {"type": "object"},
    "policy": {"type": "object"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "category",
          "source_type",
          "source_name",
          "publishers",
          "source_locators",
          "data_cutoff",
          "provenance_status",
          "claim_scope",
          "allowed_use",
          "must_reverify",
          "files"
        ],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SRC-[A-Z-]+-\\d{3}$"},
          "category": {"type": "string"},
          "source_type": {"type": "string"},
          "source_name": {"type": "string", "minLength": 2},
          "publishers": {"type": "array", "items": {"type": "string"}},
          "source_locators": {"type": "array", "items": {"type": "string"}},
          "published_at": {"type": ["string", "null"]},
          "captured_at": {"type": ["string", "null"]},
          "data_cutoff": {"type": "string"},
          "provenance_status": {"enum": ["verified", "partial", "missing"]},
          "claim_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "allowed_use": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "must_reverify": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
